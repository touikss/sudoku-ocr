# build artifacts (the directory itself is kept for the Makefile)
objects/*
!objects/.gitkeep
*.o
*.d
/main
/test_neural/main

# generated at run time (directories are kept: the program writes into them)
output/*
!output/.gitkeep
tmp/*
!tmp/.gitkeep

# editor and backup files
*~
.idea/
.vscode/
*.lnk
